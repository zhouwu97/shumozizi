{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/argument_coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "run_id", "source", "required_questions",
    "core_questions", "questions", "complete", "generated_at"
  ],
  "properties": {
    "schema_name": {"const": "argument_coverage"},
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "paper/PAPER_BLUEPRINT.md"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "required_questions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "core_questions": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id", "core_question", "obligations", "missing_obligations"
        ],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "core_question": {"type": "boolean"},
          "obligations": {
            "type": "object",
            "minProperties": 13,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["covered", "content"],
              "properties": {
                "covered": {"type": "boolean"},
                "content": {"type": "string"}
              }
            }
          },
          "missing_obligations": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "complete": {"type": "boolean"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
