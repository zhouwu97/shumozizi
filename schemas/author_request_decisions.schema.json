{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/author_request_decisions.schema.json",
  "title": "Decisions on external author material requests",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "run_id", "decisions", "generated_at"],
  "properties": {
    "schema_name": {"const": "author_request_decisions"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "decision", "route", "reason"],
        "properties": {
          "gap_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["fulfill", "substitute", "waive", "reject"]},
          "route": {"enum": ["author", "visual", "experiment", "analysis"]},
          "reason": {"type": "string", "minLength": 1},
          "scientific_value": {
            "enum": [
              "changes_understanding", "tests_mechanism", "closes_evidence_gap", null
            ]
          }
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
