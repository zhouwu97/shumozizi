{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUMCM paper structure adaptation map",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "template",
    "source_of_truth",
    "adaptation_rules",
    "sections",
    "page_planning"
  ],
  "properties": {
    "schema_name": {"const": "cumcm_structure_map"},
    "schema_version": {"enum": ["1.0", "1.1", "1.2"]},
    "run_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["classic", "semantic"]},
    "template": {
      "type": "object",
      "required": ["reference_docx", "path_scope", "usage", "placeholder_content_authoritative"],
      "properties": {
        "reference_docx": {"type": "string", "minLength": 5},
        "path_scope": {"enum": ["absolute", "run", "repository"]},
        "usage": {"const": "styles_and_outer_structure_only"},
        "placeholder_content_authoritative": {"const": false}
      },
      "additionalProperties": false
    },
    "source_of_truth": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"type": "string", "minLength": 3}
    },
    "adaptation_rules": {
      "type": "object",
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target",
          "sources",
          "purpose",
          "required_claims",
          "forbidden_content",
          "preserve_argument_order",
          "compression",
          "scope"
        ],
        "properties": {
          "section_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "role": {"$ref": "#/$defs/sectionRole"},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/sectionRole"}
          },
          "question_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "target": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "purpose": {"type": "string", "minLength": 8},
          "required_claims": {
            "type": "array",
            "items": {"type": "string", "minLength": 4},
            "uniqueItems": true
          },
          "forbidden_content": {
            "type": "array",
            "items": {"type": "string", "minLength": 2},
            "uniqueItems": true
          },
          "preserve_argument_order": {"type": "boolean"},
          "compression": {"enum": ["none", "deduplicate_only", "allowed"]},
          "scope": {"enum": ["local", "cross_question_only", "whole_paper"]}
        },
        "additionalProperties": false
      }
    },
    "presentation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "opening_reading_route", "cross_question_story",
        "answer_overview", "data_portrait", "question_hero_figures"
      ],
      "properties": {
        "mode": {"enum": ["advisory", "required"]},
        "opening_reading_route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_pages", "must_reveal", "source_path", "explanation_anchor"],
          "properties": {
            "target_pages": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 1},
                {"type": "integer", "minimum": 1}
              ],
              "items": false
            },
            "must_reveal": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 2}
            },
            "source_path": {"type": "string", "minLength": 3},
            "explanation_anchor": {"type": "string", "minLength": 4}
          }
        },
        "cross_question_story": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "must_be_visible", "source_path", "explanation_anchor"],
          "properties": {
            "source": {"enum": ["PAPER_BLUEPRINT", "ARGUMENT_PLAN"]},
            "must_be_visible": {"const": true},
            "source_path": {"type": "string", "minLength": 3},
            "explanation_anchor": {"type": "string", "minLength": 4}
          }
        },
        "answer_overview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "source_path", "explanation_anchor"],
          "properties": {
            "required": {"type": "boolean"},
            "source_path": {"type": ["string", "null"], "minLength": 3},
            "explanation_anchor": {"type": ["string", "null"], "minLength": 4}
          }
        },
        "data_portrait": {"$ref": "#/$defs/presentationDecision"},
        "question_hero_figures": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/presentationDecision"}
        }
      }
    },
    "page_planning": {
      "type": "object",
      "required": ["recommended_body_pages", "inspect_below_pages", "hard_gate"],
      "properties": {
        "recommended_body_pages": {
          "type": "array",
          "prefixItems": [{"const": 1}, {"const": 30}],
          "items": false
        },
        "inspect_below_pages": {"const": 1},
        "hard_gate": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {
        "required": ["profile", "presentation_contract"],
        "properties": {
          "sections": {
            "items": {"required": ["section_id", "role"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {
        "required": ["profile", "presentation_contract"],
        "properties": {
          "sections": {
            "items": {
              "required": ["section_id"],
              "anyOf": [
                {"required": ["role"]},
                {"required": ["roles"]}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sectionRole": {
      "enum": [
        "abstract", "problem_restatement", "problem_analysis", "assumptions",
        "symbols_or_data_definition", "data_processing", "shared_model",
        "question_solution", "local_validation", "overall_evaluation",
        "conclusion", "references", "appendix"
      ]
    },
    "presentationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "figure_id"],
      "properties": {
        "status": {"enum": ["required", "waived"]},
        "reason": {"type": "string", "minLength": 12},
        "figure_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    }
  },
  "additionalProperties": false
}
