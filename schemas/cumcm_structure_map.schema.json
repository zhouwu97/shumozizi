{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUMCM paper structure adaptation map",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "template",
    "source_of_truth",
    "adaptation_rules",
    "sections",
    "page_planning"
  ],
  "properties": {
    "schema_name": {"const": "cumcm_structure_map"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "template": {
      "type": "object",
      "required": ["reference_docx", "path_scope", "usage", "placeholder_content_authoritative"],
      "properties": {
        "reference_docx": {"type": "string", "minLength": 5},
        "path_scope": {"enum": ["absolute", "run", "repository"]},
        "usage": {"const": "styles_and_outer_structure_only"},
        "placeholder_content_authoritative": {"const": false}
      },
      "additionalProperties": false
    },
    "source_of_truth": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"type": "string", "minLength": 3}
    },
    "adaptation_rules": {
      "type": "object",
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "target",
          "sources",
          "purpose",
          "required_claims",
          "forbidden_content",
          "preserve_argument_order",
          "compression",
          "scope"
        ],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "purpose": {"type": "string", "minLength": 8},
          "required_claims": {
            "type": "array",
            "items": {"type": "string", "minLength": 4},
            "uniqueItems": true
          },
          "forbidden_content": {
            "type": "array",
            "items": {"type": "string", "minLength": 2},
            "uniqueItems": true
          },
          "preserve_argument_order": {"type": "boolean"},
          "compression": {"enum": ["none", "deduplicate_only", "allowed"]},
          "scope": {"enum": ["local", "cross_question_only", "whole_paper"]}
        },
        "additionalProperties": false
      }
    },
    "page_planning": {
      "type": "object",
      "required": ["recommended_body_pages", "inspect_below_pages", "hard_gate"],
      "properties": {
        "recommended_body_pages": {
          "type": "array",
          "prefixItems": [{"const": 24}, {"const": 30}],
          "items": false
        },
        "inspect_below_pages": {"const": 18},
        "hard_gate": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
