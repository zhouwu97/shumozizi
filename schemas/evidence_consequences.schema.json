{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/evidence_consequences.schema.json",
  "title": "Independent Evidence Consequences",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "run_id", "events"],
  "properties": {
    "schema_name": {"const": "evidence_consequences"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "source_evidence_id", "source_receipt_sha256", "negative_event", "severity", "affected_question_ids", "invalidated_claims", "invalidated_results", "invalidated_figures", "previous_phase", "new_phase", "created_at"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "source_evidence_id": {"type": "string", "minLength": 1},
          "source_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "negative_event": {"enum": ["inconsistent", "counterexample_found", "property_failed", "enumeration_mismatch", "incumbent_not_competitive", "all_actions_not_material", "feasibility_failed", "blocking_finding_open"]},
          "severity": {"const": "blocking"},
          "affected_question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "invalidated_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "invalidated_results": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "invalidated_figures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "previous_phase": {"type": "string", "minLength": 1},
          "new_phase": {"enum": ["experiment", "blocked"]},
          "created_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
