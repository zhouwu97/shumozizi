{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/figure_design_contract.schema.json",
  "title": "Figure design contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "opportunity_id",
    "visual_question",
    "atomic_claim",
    "source_result_ids",
    "candidate",
    "selected_version",
    "paper_location",
    "review_verdict",
    "policy_fingerprint",
    "panels"
  ],
  "properties": {
    "schema_name": {"const": "figure_design_contract"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "opportunity_id": {"type": "string", "minLength": 1},
    "visual_question": {"type": "string", "minLength": 1},
    "atomic_claim": {"type": "string", "minLength": 1},
    "source_result_ids": {"type": "array", "items": {"type": "string"}},
    "source_figure_ids": {"type": "array", "items": {"type": "string"}},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetype", "renderer", "version"],
      "properties": {
        "archetype": {"type": "string", "minLength": 1},
        "renderer": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "selected_version": {"type": ["string", "null"]},
    "paper_location": {"type": ["string", "null"]},
    "review_verdict": {"enum": ["PROMOTE", "REVISE", "SPLIT", "DROP", null]},
    "policy_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "material_pool_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "storyboard_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["panel_id", "takeaway"],
        "properties": {
          "panel_id": {"type": "string", "minLength": 1},
          "takeaway": {"type": "string", "minLength": 1},
          "argument_unit_id": {"type": ["string", "null"]}
        }
      }
    },
    "mechanism_annotation": {"type": "string"},
    "boundary_annotation": {"type": "string"},
    "decision_annotation": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
