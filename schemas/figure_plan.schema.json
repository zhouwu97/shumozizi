{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/figure_plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "run_id", "figures"],
  "properties": {
    "schema_name": {"const": "figure_plan"},
    "schema_version": {"enum": ["2.0", "2.1", "2.2", "2.3", "2.4"]},
    "run_id": {"type": "string", "minLength": 1},
    "visual_strategy": {"enum": ["fixed_contract", "opportunity_pool"]},
    "visual_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "status": {"enum": ["required", "waived"]},
          "evidence_need": {"enum": ["required", "waived"]},
          "presentation_need": {"enum": ["required", "waived"]},
          "reason": {"type": "string", "minLength": 16},
          "waiver_review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewed", "reviewer_context_id", "reader_question", "verdict",
              "reason", "replacement_medium"
            ],
            "properties": {
              "reviewed": {"const": true},
              "reviewer_context_id": {"type": "string", "minLength": 8},
              "reader_question": {"type": "string", "minLength": 12},
              "verdict": {"const": "waived"},
              "reason": {"type": "string", "minLength": 16},
              "replacement_medium": {"type": "string", "minLength": 3},
              "waived_obligation_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"required": ["waiver_review"]},
            "then": {
              "anyOf": [
                {"required": ["status"], "properties": {"status": {"const": "waived"}}},
                {"required": ["evidence_need"], "properties": {"evidence_need": {"const": "waived"}}},
                {"required": ["presentation_need"], "properties": {"presentation_need": {"const": "waived"}}},
                {
                  "properties": {
                    "waiver_review": {"required": ["waived_obligation_types"]}
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["figure_id", "preferred", "fallback", "selected_skill", "template_id", "selection_reason"],
        "properties": {
          "figure_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "preferred": {"const": "skills/mathmodel-figure-templates"},
          "fallback": {"const": "skills/3coding-visual"},
          "selected_skill": {"enum": ["skills/mathmodel-figure-templates", "skills/3coding-visual"]},
          "template_id": {"enum": [
            "multiclass-shap-combo", "paired-raincloud", "cv-roc-ci", "taylor-diagram",
            "correlation-pairgrid", "prediction-marginal-grid", "rf-tpe-surface",
            "grouped-corr-split-violin", "grouped-circular-heatmap", "urban-park-cooling-combo",
            "nature-chord-diagram", "feasible-region-active-constraints",
            "interval-event-timeline", "uncertainty-fan-threshold",
            "multi-panel-evidence-chain", "active_constraint_map",
            "constraint_margin_timeline", "uncertainty_threshold_ribbon",
            "model_evolution_schematic", "argument_evidence_map",
            "cumcm_semantic_v34", "cumcm_classic_v34", "custom"
          ]},
          "selection_reason": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["model_understanding", "decisive_evidence", "insight", "stability"]},
          "presentation_role": {
            "enum": ["data_portrait", "question_hero", "supporting", "appendix"]
          },
          "claim": {"type": "string", "minLength": 1},
          "source_result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "script": {"type": "string", "minLength": 1},
          "output": {"type": "string", "minLength": 1},
          "paper_section": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "latex_label": {"type": "string", "pattern": "^fig:[A-Za-z0-9._:-]+$"},
          "explanation_anchor": {"type": "string", "minLength": 4},
          "required": {"type": "boolean"},
          "argument_unit_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          },
          "obligation_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "data_intuition", "mathematical_object", "model_structure",
                "derivation", "algorithm", "result", "mechanism", "comparison",
                "uncertainty", "boundary", "decision"
              ]
            }
          },
          "panel_mapping": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["panel", "argument_unit_id", "takeaway"],
              "properties": {
                "panel": {"type": "string", "minLength": 1},
                "argument_unit_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
                "takeaway": {"type": "string", "minLength": 8}
              }
            }
          },
          "visual_archetype": {
            "enum": [
              "spatial_scene_with_constraints",
              "spatial_trajectory_with_constraints",
              "pareto_feasible_region",
              "response_surface_with_constraints",
              "decision_surface_with_fallback",
              "uncertainty_fan_with_threshold",
              "network_flow_bottleneck",
              "spatiotemporal_density",
              "classifier_diagnostic_bundle",
              "cluster_structure_embedding",
              "phase_field_bifurcation",
              "search_trajectory_envelope",
              "multi_panel_evidence_chain",
              "geometric_section_projection",
              "interval_event_timeline",
              "feasible_region_active_constraints",
              "state_control_event_timeline",
              "route_score_comparison",
              "custom"
            ]
          },
          "information_structure": {
            "enum": [
              "spatial", "temporal", "set", "network", "field", "tradeoff",
              "uncertainty"
            ]
          },
          "generic_chart_considered": {"type": "boolean"},
          "generic_chart_rejected_because": {"type": "string", "minLength": 12},
          "generic_chart_override_reason": {"type": "string", "minLength": 16},
          "mechanism_annotation": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 2}
          },
          "renderer": {"enum": ["python", "matlab", "octave", "other"]},
          "visual_question": {"type": "string", "minLength": 8},
          "expected_observation": {"type": "string", "minLength": 8},
          "decision_consequence": {"type": "string", "minLength": 8},
          "review_finding": {"type": "string", "minLength": 12},
          "revision_case": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "review_finding", "estimated_cost", "expected_benefit", "stop_condition"
            ],
            "properties": {
              "review_finding": {"type": "string", "minLength": 8},
              "estimated_cost": {"type": "string", "minLength": 8},
              "expected_benefit": {"type": "string", "minLength": 8},
              "stop_condition": {"type": "string", "minLength": 8}
            }
          },
          "learned_pattern_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3}
          },
          "learned_pattern_adaptation": {
            "type": "string",
            "minLength": 16
          }
        },
        "allOf": [
          {
            "if": {"properties": {"selected_skill": {"const": "skills/mathmodel-figure-templates"}}},
            "then": {"properties": {"template_id": {"not": {"const": "custom"}}}}
          },
          {
            "if": {"properties": {"selected_skill": {"const": "skills/3coding-visual"}}},
            "then": {"properties": {"template_id": {"const": "custom"}}}
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.1"}}},
      "then": {
        "required": ["visual_decisions"],
        "properties": {
          "visual_decisions": {
            "items": {"required": ["question_id", "status", "reason"]}
          },
          "figures": {
            "items": {
              "required": ["question_id", "role", "claim", "source_result_ids", "script", "output", "paper_section", "caption", "latex_label", "explanation_anchor", "required"],
              "properties": {"source_result_ids": {"minItems": 1}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.2"}}},
      "then": {
        "required": ["visual_decisions"],
        "properties": {
          "visual_decisions": {
            "items": {"required": ["question_id", "status", "reason"]}
          },
          "figures": {
            "items": {
              "required": [
                "question_id", "role", "claim", "source_result_ids", "script",
                "output", "paper_section", "caption", "latex_label",
                "explanation_anchor", "required", "visual_archetype", "renderer",
                "visual_question", "expected_observation", "decision_consequence"
              ],
              "properties": {"source_result_ids": {"minItems": 1}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.3"}}},
      "then": {
        "required": ["visual_decisions"],
        "properties": {
          "visual_decisions": {
            "items": {
              "required": ["scope", "evidence_need", "presentation_need", "reason"]
            }
          },
          "figures": {
            "items": {
              "required": [
                "question_id", "role", "presentation_role", "claim",
                "source_result_ids", "script", "output", "paper_section",
                "caption", "latex_label", "explanation_anchor", "required",
                "visual_archetype", "renderer", "visual_question",
                "expected_observation", "decision_consequence"
              ],
              "anyOf": [
                {"properties": {"source_result_ids": {"minItems": 1}}},
                {"required": ["source_files"]}
              ],
              "allOf": [
                {
                  "if": {
                    "required": ["presentation_role"],
                    "properties": {
                      "presentation_role": {
                        "enum": ["data_portrait", "question_hero"]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "information_structure", "generic_chart_considered",
                      "generic_chart_rejected_because", "mechanism_annotation"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.4"}}},
      "then": {
        "required": ["visual_decisions"],
        "properties": {
          "visual_decisions": {
            "items": {
              "required": ["scope", "evidence_need", "presentation_need", "reason"]
            }
          },
          "figures": {
            "items": {
              "required": [
                "question_id", "role", "presentation_role", "claim",
                "source_result_ids", "script", "output", "paper_section",
                "caption", "latex_label", "explanation_anchor", "required",
                "argument_unit_ids", "obligation_types", "visual_archetype",
                "renderer", "visual_question", "expected_observation",
                "decision_consequence"
              ],
              "anyOf": [
                {"properties": {"source_result_ids": {"minItems": 1}}},
                {"required": ["source_files"]}
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {"obligation_types": {"minItems": 3}},
                    "required": ["obligation_types"]
                  },
                  "then": {
                    "required": ["panel_mapping"],
                    "properties": {"panel_mapping": {"minItems": 2}}
                  }
                },
                {
                  "if": {
                    "required": ["presentation_role"],
                    "properties": {
                      "presentation_role": {
                        "enum": ["data_portrait", "question_hero"]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "information_structure", "generic_chart_considered",
                      "generic_chart_rejected_because", "mechanism_annotation"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
