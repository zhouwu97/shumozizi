{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/figure_plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "run_id", "figures"],
  "properties": {
    "schema_name": {"const": "figure_plan"},
    "schema_version": {"enum": ["2.0", "2.1"]},
    "run_id": {"type": "string", "minLength": 1},
    "visual_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "status", "reason"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["required", "waived"]},
          "reason": {"type": "string", "minLength": 16}
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["figure_id", "preferred", "fallback", "selected_skill", "template_id", "selection_reason"],
        "properties": {
          "figure_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "preferred": {"const": "skills/mathmodel-figure-templates"},
          "fallback": {"const": "skills/3coding-visual"},
          "selected_skill": {"enum": ["skills/mathmodel-figure-templates", "skills/3coding-visual"]},
          "template_id": {"enum": [
            "multiclass-shap-combo", "paired-raincloud", "cv-roc-ci", "taylor-diagram",
            "correlation-pairgrid", "prediction-marginal-grid", "rf-tpe-surface",
            "grouped-corr-split-violin", "grouped-circular-heatmap", "urban-park-cooling-combo",
            "nature-chord-diagram", "custom"
          ]},
          "selection_reason": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["model_understanding", "decisive_evidence", "insight", "stability"]},
          "claim": {"type": "string", "minLength": 1},
          "source_result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "script": {"type": "string", "minLength": 1},
          "output": {"type": "string", "minLength": 1},
          "paper_section": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "latex_label": {"type": "string", "pattern": "^fig:[A-Za-z0-9._:-]+$"},
          "explanation_anchor": {"type": "string", "minLength": 4},
          "required": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"selected_skill": {"const": "skills/mathmodel-figure-templates"}}},
            "then": {"properties": {"template_id": {"not": {"const": "custom"}}}}
          },
          {
            "if": {"properties": {"selected_skill": {"const": "skills/3coding-visual"}}},
            "then": {"properties": {"template_id": {"const": "custom"}}}
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.1"}}},
      "then": {
        "required": ["visual_decisions"],
        "properties": {
          "figures": {
            "items": {
              "required": ["question_id", "role", "claim", "source_result_ids", "script", "output", "paper_section", "caption", "latex_label", "explanation_anchor", "required"]
            }
          }
        }
      }
    }
  ]
}
