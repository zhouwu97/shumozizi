{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/imported_author_receipt.schema.json",
  "title": "Materialized external author draft receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "run_id", "entrypoint_path",
    "entrypoint_sha256", "source_draft_path", "external_draft_sha256",
    "import_audit_path", "import_audit_sha256", "handoff_revision", "generated_at"
  ],
  "properties": {
    "schema_name": {"const": "imported_author_receipt"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "entrypoint_path": {"type": "string", "minLength": 1},
    "entrypoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_draft_path": {"type": "string", "minLength": 1},
    "external_draft_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "import_audit_path": {"type": "string", "minLength": 1},
    "import_audit_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "handoff_revision": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
