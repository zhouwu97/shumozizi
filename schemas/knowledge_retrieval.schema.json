{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competition-First run knowledge retrieval",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "stage",
    "run_id",
    "status",
    "task_fingerprint",
    "matched_cards",
    "accepted_patterns",
    "rejected_patterns",
    "forbidden_transfer",
    "no_match_reason",
    "unavailable_reason"
  ],
  "properties": {
    "schema_name": {"const": "knowledge_retrieval"},
    "schema_version": {"const": "1.0"},
    "stage": {"const": "analysis"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["matched", "no_relevant_match", "unavailable_with_reason"]
    },
    "task_fingerprint": {
      "type": "object",
      "required": [
        "problem_type",
        "data_structure",
        "task_types",
        "statistical_units",
        "mathematical_difficulties",
        "objective_structures",
        "constraint_types",
        "validation_risks",
        "question_chain",
        "structural_tags",
        "keywords"
      ],
      "properties": {
        "problem_type": {"type": "string", "minLength": 1},
        "data_structure": {"type": "string", "minLength": 1},
        "task_types": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "statistical_units": {"$ref": "#/$defs/textList"},
        "mathematical_difficulties": {"$ref": "#/$defs/textList"},
        "objective_structures": {"$ref": "#/$defs/textList"},
        "constraint_types": {"$ref": "#/$defs/textList"},
        "validation_risks": {"$ref": "#/$defs/textList"},
        "question_chain": {"$ref": "#/$defs/textList"},
        "structural_tags": {"$ref": "#/$defs/textList"},
        "keywords": {"$ref": "#/$defs/textList"}
      },
      "additionalProperties": false
    },
    "matched_cards": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/matchedCard"}
    },
    "accepted_patterns": {
      "type": "array",
      "items": {"$ref": "#/$defs/acceptedPattern"}
    },
    "rejected_patterns": {
      "type": "array",
      "items": {"$ref": "#/$defs/rejectedPattern"}
    },
    "forbidden_transfer": {
      "type": "array",
      "prefixItems": [
        {"const": "原题参数"},
        {"const": "公式和代码"},
        {"const": "数值结论"},
        {"const": "奖项评价"}
      ],
      "items": false
    },
    "no_match_reason": {"type": ["string", "null"]},
    "unavailable_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "textList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "candidatePattern": {
      "type": "object",
      "required": ["pattern_id", "pattern"],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 3},
        "pattern": {"type": "string", "minLength": 8}
      },
      "additionalProperties": false
    },
    "matchedCard": {
      "type": "object",
      "required": [
        "paper_id",
        "title",
        "score",
        "structural_similarity",
        "domain_similarity",
        "matched_on",
        "candidate_patterns"
      ],
      "properties": {
        "paper_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "score": {"type": "number", "minimum": 0},
        "structural_similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "domain_similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "matched_on": {"$ref": "#/$defs/textList"},
        "candidate_patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/candidatePattern"}
        },
        "visual_patterns": {
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "#/$defs/visualPattern"}
        },
        "failure_mode_lessons": {
          "type": "object",
          "properties": {
            "key_interpretation_decision": {"type": "string", "minLength": 8},
            "tempting_wrong_interpretation": {"type": "string", "minLength": 8},
            "minimal_discriminating_counterexample": {"type": "string", "minLength": 8},
            "decomposition_conditions": {"type": "string", "minLength": 8},
            "validity_scope": {"type": "string", "minLength": 8}
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "acceptedPattern": {
      "type": "object",
      "required": ["pattern_id", "reason", "route_application"],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 3},
        "reason": {"type": "string", "minLength": 8},
        "route_application": {"type": "string", "minLength": 8},
        "application_layer": {"enum": ["analysis_route", "validation_design", "visual_design", "paper_structure"]},
        "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "current_problem_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
        "adaptation": {"type": "string", "minLength": 8},
        "expected_effect": {"type": "string", "minLength": 8},
        "falsification_condition": {"type": "string", "minLength": 8},
        "status": {"enum": ["planned", "validated", "revised", "rejected_by_evidence", "not_executed"]},
        "evidence_result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_effect": {"type": "string", "minLength": 8},
        "conclusion": {"type": "string", "minLength": 8},
        "visual_pattern_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "figure_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "validation_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_id", "validation_kind", "metric", "pass_criterion"],
            "properties": {
              "target_id": {"type": "string", "minLength": 1},
              "validation_kind": {"enum": ["oracle", "sensitivity", "robustness", "natural_comparison", "data_split", "diagnostic", "calibration", "convergence"]},
              "metric": {"type": "string", "minLength": 3},
              "pass_criterion": {"type": "string", "minLength": 8}
            }
          }
        },
        "paper_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blueprint_anchor", "source_path", "realization_anchor"],
            "properties": {
              "blueprint_anchor": {"type": "string", "minLength": 4},
              "source_path": {"type": "string", "pattern": "^paper/.+\\.(tex|typ)$"},
              "realization_anchor": {"type": "string", "minLength": 4}
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["application_layer"]},
          "then": {"required": ["target_ids", "current_problem_basis", "adaptation", "expected_effect", "falsification_condition", "status"]}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["validated", "revised", "rejected_by_evidence"]}}},
          "then": {"required": ["evidence_result_ids", "observed_effect", "conclusion"]}
        },
        {
          "if": {"required": ["application_layer"], "properties": {"application_layer": {"const": "validation_design"}}},
          "then": {"required": ["validation_bindings"]}
        },
        {
          "if": {"required": ["application_layer"], "properties": {"application_layer": {"const": "visual_design"}}},
          "then": {"required": ["visual_pattern_ids", "figure_ids"]}
        },
        {
          "if": {"required": ["application_layer"], "properties": {"application_layer": {"const": "paper_structure"}}},
          "then": {"required": ["paper_bindings"]}
        }
      ]
    },
    "rejectedPattern": {
      "type": "object",
      "required": ["pattern_id", "reason"],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 3},
        "reason": {"type": "string", "minLength": 8}
      },
      "additionalProperties": false
    },
    "visualPattern": {
      "type": "object",
      "required": ["pattern_id", "visual_archetype", "argument_roles", "reading_order", "visible_elements", "required_data_fields", "applicable_when", "not_applicable_when", "transferable_principle"],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 3},
        "source_pages": {"type": "array", "items": {"type": ["integer", "string"]}},
        "information_structure": {"type": "string", "minLength": 1},
        "visual_archetype": {"type": "string", "minLength": 1},
        "argument_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "panel_layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rows": {"type": "integer", "minimum": 1},
            "columns": {"type": "integer", "minimum": 1},
            "arrangement": {"type": "string", "minLength": 1}
          }
        },
        "reading_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "visible_elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_data_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "applicable_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
        "not_applicable_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
        "transferable_principle": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
        "conclusion_supported": {"type": "string", "minLength": 8},
        "mathematical_object": {"type": "string", "minLength": 3},
        "why_table_insufficient": {"type": "string", "minLength": 8},
        "key_elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decorative_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "nontransferable_elements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "renderer_feasibility": {"type": "string", "minLength": 8}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
