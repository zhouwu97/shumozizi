{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/literature_source.schema.json",
  "title": "Literature Source Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "source_id", "title", "authors", "year", "language", "discovery_provider", "canonical_source", "source_type", "verification_level", "selection_status", "categories", "retrieved_at"],
  "properties": {
    "schema_name": {"const": "literature_source"},
    "schema_version": {"const": "2.0"},
    "source_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "year": {"type": "integer", "minimum": 0, "maximum": 3000},
    "language": {"enum": ["zh", "en", "multilingual"]},
    "discovery_provider": {"enum": ["cnki", "wanfang", "vip", "library-discovery", "crossref", "openalex", "google-scholar", "official-web", "publisher", "other"]},
    "canonical_source": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["journal", "conference", "book", "standard", "report", "web", "thesis", "other"]},
    "verification_level": {"enum": ["metadata", "abstract", "fulltext"]},
    "abstract_checked": {"type": "boolean"},
    "fulltext_checked": {"type": "boolean"},
    "selection_status": {"enum": ["selected", "rejected", "pending"]},
    "categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["background", "core_method", "validation", "uncertainty", "extension"]}},
    "claim_bindings": {"type": "array", "items": {"type": "string"}},
    "rejection_reason": {"type": ["string", "null"]},
    "identifiers": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "doi": {"type": "string"}, "cnki_identifier": {"type": "string"}, "url": {"type": "string", "format": "uri"}
      }
    },
    "local_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "private"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "private": {"const": true}
      }
    },
    "retrieved_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"required": ["selection_status"], "properties": {"selection_status": {"const": "rejected"}}}, "then": {"required": ["rejection_reason"]}},
    {"if": {"required": ["selection_status"], "properties": {"selection_status": {"const": "selected"}}}, "then": {"required": ["claim_bindings"]}}
  ]
}
