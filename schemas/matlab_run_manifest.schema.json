{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/matlab_run_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "run_id", "result_id", "question_id", "role",
    "engine", "availability", "entrypoint", "matlab_version", "toolboxes", "command",
    "input_files", "output_files", "stdout_path", "stderr_path", "started_at",
    "finished_at", "elapsed_seconds", "exit_status", "execution_valid",
    "unavailable_reason"
  ],
  "properties": {
    "schema_name": {"const": "matlab_run_manifest"},
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "result_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "question_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["primary_model", "optimizer_challenger", "independent_oracle", "scientific_visualization"]},
    "engine": {"enum": ["matlab", "octave"]},
    "availability": {"enum": ["available", "unavailable"]},
    "entrypoint": {"type": "string", "pattern": "^code/matlab/.+\\.m$"},
    "matlab_version": {"type": ["string", "null"]},
    "toolboxes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "array", "items": {"type": "string"}},
    "input_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output_files": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stdout_path": {"type": "string", "minLength": 1},
    "stderr_path": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "exit_status": {"type": ["integer", "null"]},
    "execution_valid": {"type": "boolean"},
    "unavailable_reason": {"type": ["string", "null"]}
  }
}
