{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/narrative_competition.schema.json",
  "title": "Narrative competition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "run_id", "research_package_sha256", "status", "candidates", "updated_at"],
  "properties": {
    "schema_name": {"const": "narrative_competition"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "research_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["draft", "reviewed"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "title", "central_thread", "section_flow", "memorable_takeaway", "risks"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "central_thread": {"type": "string", "minLength": 1},
          "section_flow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "memorable_takeaway": {"type": "string", "minLength": 1},
          "risks": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "selected_candidate_id": {"type": "string", "minLength": 1},
    "reviewer_context_id": {"type": "string", "minLength": 1},
    "selection_reason": {"type": "string", "minLength": 1},
    "revision_advice": {"type": "string", "minLength": 1}
  }
}
