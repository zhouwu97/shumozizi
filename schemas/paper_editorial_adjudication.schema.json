{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/paper_editorial_adjudication.schema.json",
  "title": "Editorial adjudication of reviewer findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "run_id", "source_pdf",
    "reviewer_findings_sha256", "decisions", "generated_at"
  ],
  "properties": {
    "schema_name": {"const": "paper_editorial_adjudication"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_pdf": {"type": "string", "minLength": 1},
    "reviewer_findings_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "confirmed", "confirmed_severity", "route", "decision", "reason"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "confirmed": {"type": "boolean"},
          "confirmed_severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "route": {"enum": ["author", "visual", "experiment", "analysis", "render"]},
          "decision": {
            "enum": ["accept", "rework", "substitute", "reject", "waive"]
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
