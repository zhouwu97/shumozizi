{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/paper_reviewer_findings.schema.json",
  "title": "Fresh reviewer findings on a frozen external-author draft",
  "description": "Fresh Reviewer 审阅外部 Author 的原始草稿 PDF（paper/external-author/draft.pdf），职责是论证/写作/图表叙事与科学主张，不是最终排版产物审查；正式 final.pdf 的整体表现由独立 Final Blind Review 负责。回执必须绑定 source_pdf_sha256 / paper_policy_fingerprint / external_draft_sha256，PDF 或草稿变化即 stale。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "run_id", "source_pdf",
    "source_pdf_sha256", "reviewer_context_id", "paper_policy_fingerprint",
    "external_draft_sha256", "findings", "generated_at"
  ],
  "properties": {
    "schema_name": {"const": "paper_reviewer_findings"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_pdf": {"type": "string", "minLength": 1},
    "source_pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_context_id": {"type": "string", "minLength": 1},
    "paper_policy_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "external_draft_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id", "finding_class", "severity_recommendation", "location",
          "observation", "why_it_matters", "suggested_route", "minimum_fix",
          "acceptance_test"
        ],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "finding_class": {
            "enum": [
              "scientific_fact_candidate", "scientific_support", "argument",
              "visual", "writing", "layout", "citation", "unclassified"
            ]
          },
          "novelty_reason": {"type": "string", "description": "仅 finding_class=unclassified 时必填：说明为什么现有分类无法覆盖该问题。"},
          "severity_recommendation": {"enum": ["P0", "P1", "P2", "P3"]},
          "location": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "suggested_route": {
            "enum": ["author", "visual", "experiment", "analysis", "render"]
          },
          "minimum_fix": {"type": "string", "minLength": 1},
          "acceptance_test": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"finding_class": {"const": "unclassified"}}, "required": ["finding_class"]},
            "then": {"required": ["novelty_reason"]}
          }
        ]
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
