{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/paper_visual_requirements.schema.json",
  "title": "Paper-driven visual requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "generation_policy",
    "figure_tiers",
    "input_hashes",
    "requirements",
    "summary",
    "generated_at"
  ],
  "properties": {
    "schema_name": {"const": "paper_visual_requirements"},
    "schema_version": {"enum": ["1.0", "1.1", "1.2"]},
    "run_id": {"type": "string", "minLength": 1},
    "generation_policy": {"const": "argument_driven_no_figure_count_target"},
    "figure_tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_figure", "supporting_figure"],
      "properties": {
        "hero_figure": {"type": "string", "minLength": 1},
        "supporting_figure": {"type": "string", "minLength": 1}
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "discovery_blind_to_requirements", "discovery_artifact"],
      "properties": {
        "mode": {"const": "open_world_discovery_then_requirement_reconciliation"},
        "discovery_blind_to_requirements": {"const": true},
        "discovery_artifact": {"const": "review/VISUAL_DISCOVERY.json"}
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "requirement_digest",
          "question_id",
          "figure_tier",
          "purpose",
          "mathematical_object",
          "claim",
          "visual_question",
          "source_result_ids",
          "source_insight_ids",
          "argument_unit_ids",
          "preferred_structures",
          "forbidden_defaults",
          "preferred_archetypes",
          "covered_by_figure_ids",
          "status"
        ],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "requirement_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "question_id": {"type": "string", "minLength": 1},
          "figure_tier": {"enum": ["hero_figure", "supporting_figure"]},
          "purpose": {
            "enum": ["model_understanding", "decisive_evidence", "mechanism", "boundary"]
          },
          "mathematical_object": {"type": "string"},
          "claim": {"type": "string", "minLength": 1},
          "visual_question": {"type": "string", "minLength": 1},
          "source_result_ids": {"type": "array", "items": {"type": "string"}},
          "source_insight_ids": {"type": "array", "items": {"type": "string"}},
          "argument_unit_ids": {"type": "array", "items": {"type": "string"}},
          "preferred_structures": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "forbidden_defaults": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "required_visibility": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "preferred_archetypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "renderer_status", "required_data"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "renderer_status": {"enum": ["available", "design_only"]},
                "required_data": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "source_span": {"type": ["string", "null"]},
          "paper_image_opportunity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recommended_visual_type",
              "priority",
              "reason",
              "expected_value",
              "production_status"
            ],
            "properties": {
              "recommended_visual_type": {
                "enum": ["academic_flowchart", "mechanism_diagram", "timeline_diagram"]
              },
              "priority": {"enum": ["high", "medium", "low"]},
              "reason": {"type": "string", "minLength": 1},
              "expected_value": {"enum": ["explain_method", "explain_structure"]},
              "production_status": {"enum": ["planned", "suggested_only"]}
            }
          },
          "covered_by_figure_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["open", "covered"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "covered", "open"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "open": {"type": "integer", "minimum": 0}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {"required": ["review_policy"]}
    }
  ]
}
