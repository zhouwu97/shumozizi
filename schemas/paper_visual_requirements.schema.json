{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/paper_visual_requirements.schema.json",
  "title": "Paper-driven visual requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "generation_policy",
    "figure_tiers",
    "input_hashes",
    "requirements",
    "summary",
    "generated_at"
  ],
  "properties": {
    "schema_name": {"const": "paper_visual_requirements"},
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]},
    "run_id": {"type": "string", "minLength": 1},
    "generation_policy": {
      "enum": [
        "argument_driven_no_figure_count_target",
        "argument_driven_with_advanced_figure_quota",
        "argument_driven_with_adaptive_figure_quota"
      ]
    },
    "figure_tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_figure", "supporting_figure"],
      "properties": {
        "hero_figure": {"type": "string", "minLength": 1},
        "supporting_figure": {"type": "string", "minLength": 1}
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "discovery_blind_to_requirements", "discovery_artifact"],
      "properties": {
        "mode": {"const": "open_world_discovery_then_requirement_reconciliation"},
        "discovery_blind_to_requirements": {"const": true},
        "discovery_artifact": {"const": "review/VISUAL_DISCOVERY.json"}
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "requirement_digest",
          "question_id",
          "figure_tier",
          "purpose",
          "mathematical_object",
          "claim",
          "visual_question",
          "source_result_ids",
          "source_insight_ids",
          "argument_unit_ids",
          "preferred_structures",
          "forbidden_defaults",
          "preferred_archetypes",
          "covered_by_figure_ids",
          "status"
        ],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "requirement_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "question_id": {"type": "string", "minLength": 1},
          "figure_tier": {"enum": ["hero_figure", "supporting_figure"]},
          "purpose": {
            "enum": ["model_understanding", "decisive_evidence", "mechanism", "boundary"]
          },
          "mathematical_object": {"type": "string"},
          "claim": {"type": "string", "minLength": 1},
          "visual_question": {"type": "string", "minLength": 1},
          "source_result_ids": {"type": "array", "items": {"type": "string"}},
          "source_insight_ids": {"type": "array", "items": {"type": "string"}},
          "argument_unit_ids": {"type": "array", "items": {"type": "string"}},
          "preferred_structures": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "forbidden_defaults": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "required_visibility": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "source_artifact_paths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "preferred_archetypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "renderer_status", "required_data"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "renderer_status": {"enum": ["available", "design_only"]},
                "required_data": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "source_span": {"type": ["string", "null"]},
          "paper_image_opportunity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recommended_visual_type",
              "priority",
              "reason",
              "expected_value",
              "production_status"
            ],
            "properties": {
              "recommended_visual_type": {
                "anyOf": [
                  {"const": "academic_flowchart"},
                  {"const": "mechanism_diagram"},
                  {"const": "timeline_diagram"},
                  {"type": "null"}
                ]
              },
              "priority": {"enum": ["high", "medium", "low"]},
              "reason": {"type": "string", "minLength": 1},
              "expected_value": {
                "enum": ["explain_method", "explain_structure", "evidence_figure"]
              },
              "production_status": {"enum": ["planned", "suggested_only", "renderer_ready"]},
              "production_path": {"enum": ["deterministic_renderer", "ai_image"]},
              "renderer_archetype": {"type": "string"}
            }
          },
          "covered_by_figure_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["open", "covered"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "covered", "open"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "open": {"type": "integer", "minimum": 0}
      }
    },
    "advanced_figure_quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_required_question",
        "minimum_formal_current_figures",
        "minimum_visual_archetypes",
        "count_scope"
      ],
      "properties": {
        "required_question_count": {"type": "integer", "minimum": 0},
        "per_required_question": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"const": 2},
            "maximum": {"const": 3}
          }
        },
        "overall_enforcement": {
          "enum": ["hard_minimum", "coverage_driven_editorial_target"]
        },
        "minimum_formal_current_figures": {"type": ["integer", "null"], "minimum": 0},
        "minimum_visual_archetypes": {"type": ["integer", "null"], "minimum": 0},
        "editorial_target": {"type": "string", "minLength": 1},
        "count_scope": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "required": ["overall_enforcement"],
            "properties": {"overall_enforcement": {"const": "hard_minimum"}}
          },
          "then": {
            "properties": {
              "minimum_formal_current_figures": {"const": 12},
              "minimum_visual_archetypes": {"const": 3}
            }
          }
        },
        {
          "if": {
            "required": ["overall_enforcement"],
            "properties": {"overall_enforcement": {"const": "coverage_driven_editorial_target"}}
          },
          "then": {
            "properties": {
              "minimum_formal_current_figures": {"type": "null"},
              "minimum_visual_archetypes": {"type": "null"}
            }
          }
        }
      ]
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": ["1.2", "1.3", "1.4"]}}},
      "then": {"required": ["review_policy"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.3"}}},
      "then": {
        "required": ["advanced_figure_quota"],
        "properties": {
          "generation_policy": {"const": "argument_driven_with_advanced_figure_quota"}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.4"}}},
      "then": {
        "required": ["advanced_figure_quota"],
        "properties": {
          "generation_policy": {"const": "argument_driven_with_adaptive_figure_quota"},
          "advanced_figure_quota": {
            "required": [
              "required_question_count",
              "per_required_question",
              "overall_enforcement",
              "minimum_formal_current_figures",
              "minimum_visual_archetypes",
              "editorial_target",
              "count_scope"
            ]
          }
        }
      }
    }
  ]
}
