{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/paper_visual_requirements.schema.json",
  "title": "Paper-driven visual requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "generation_policy",
    "figure_tiers",
    "input_hashes",
    "requirements",
    "summary",
    "generated_at"
  ],
  "properties": {
    "schema_name": {"const": "paper_visual_requirements"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generation_policy": {"const": "argument_driven_no_figure_count_target"},
    "figure_tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_figure", "supporting_figure"],
      "properties": {
        "hero_figure": {"type": "string", "minLength": 1},
        "supporting_figure": {"type": "string", "minLength": 1}
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "question_id",
          "figure_tier",
          "purpose",
          "claim",
          "visual_question",
          "source_result_ids",
          "source_insight_ids",
          "argument_unit_ids",
          "preferred_structures",
          "covered_by_figure_ids",
          "status"
        ],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "minLength": 1},
          "figure_tier": {"enum": ["hero_figure", "supporting_figure"]},
          "purpose": {
            "enum": ["model_understanding", "decisive_evidence", "mechanism", "boundary"]
          },
          "claim": {"type": "string", "minLength": 1},
          "visual_question": {"type": "string", "minLength": 1},
          "source_result_ids": {"type": "array", "items": {"type": "string"}},
          "source_insight_ids": {"type": "array", "items": {"type": "string"}},
          "argument_unit_ids": {"type": "array", "items": {"type": "string"}},
          "preferred_structures": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "covered_by_figure_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["open", "covered"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "covered", "open"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "open": {"type": "integer", "minimum": 0}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
