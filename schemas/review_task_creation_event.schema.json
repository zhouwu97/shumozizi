{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/review_task_creation_event.schema.json",
  "title": "Review Task Creation Event",
  "description": "协调器从 provider 响应直接保存的最小原始元数据；不得由完成回执自报。支持 Codex create_thread、Claude dispatch_agent 和经用户明确要求的网页版 GPT 新聊天。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "provider", "raw_task_id", "raw_thread_id", "creation_mode", "parent_context_inherited", "created_at"],
  "properties": {
    "schema_name": {"const": "review_task_creation_event"},
    "schema_version": {"const": "1.0"},
    "provider": {"enum": ["codex", "claude", "web_gpt"]},
    "raw_task_id": {"type": "string", "minLength": 1},
    "raw_thread_id": {"type": "string", "minLength": 1},
    "creation_mode": {"enum": ["create_thread", "dispatch_agent", "web_chat"]},
    "parent_context_inherited": {"const": false},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"const": "codex"}}},
      "then": {"properties": {"creation_mode": {"const": "create_thread"}}}
    },
    {
      "if": {"properties": {"provider": {"const": "claude"}}},
      "then": {"properties": {"creation_mode": {"const": "dispatch_agent"}}}
    },
    {
      "if": {"properties": {"provider": {"const": "web_gpt"}}},
      "then": {"properties": {"creation_mode": {"const": "web_chat"}}}
    }
  ]
}
