{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/simple_figure_index.schema.json",
  "title": "Capability-First v3 Figure Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "figures"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
         "required": ["figure_id", "status", "paper_allowed", "demo", "created_at"],
        "properties": {
          "figure_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
           "template_id": {"type": "string", "minLength": 1},
          "result_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "input_result": {"$ref": "#/$defs/file"},
          "reference_template": {"$ref": "#/$defs/file"},
          "renderer_script": {"$ref": "#/$defs/file"},
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/file"}
          },
          "text_boxes": {"$ref": "#/$defs/file"},
          "status": {"enum": ["current", "superseded", "failed"]},
          "superseded_reason": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "figure_stage": {"enum": ["current", "evidence", "publication"]},
          "scientific_question": {"type": "string", "minLength": 16},
          "expected_takeaway": {"type": "string", "minLength": 16},
          "cannot_prove": {"type": "string", "minLength": 16},
          "source_result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_result_sha256s": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha"}},
          "provenance_type": {"enum": ["result", "frozen_inputs"]},
          "source_files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/file"}
          },
          "presentation_role": {
            "enum": ["data_portrait", "question_hero", "supporting", "appendix"]
          },
           "objective_semantics_sha256": {"$ref": "#/$defs/sha"},
           "source": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
           "question": {"type": "string", "minLength": 1},
           "takeaway": {"type": "string", "minLength": 1},
           "limitations": {"type": "string", "minLength": 1},
           "role": {"enum": ["model_understanding", "decisive_evidence", "insight", "stability"]},
          "placement": {"enum": ["body", "appendix"]},
          "promotion_receipt": {"$ref": "#/$defs/file"},
          "visual_opportunity_id": {"type": "string", "minLength": 1},
          "covered_requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "covered_requirement_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "focal_claim": {"type": "string", "minLength": 1},
          "selected_version": {"type": "string", "minLength": 1},
          "paper_location": {"type": "string", "minLength": 1},
          "critic_verdict": {"enum": ["PROMOTE", "REVISE", "SPLIT", "DROP"]},
          "visual_policy_fingerprint": {"$ref": "#/$defs/sha"},
          "paper_allowed": {"type": "boolean"},
          "demo": {"const": false},
          "created_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "1.0/1.1 沿用 PNG+PDF+SVG 三份输出；1.2 起只要求可读 PNG 或 PDF，不再靠输出份数凑数量。",
      "if": {"properties": {"schema_version": {"enum": ["1.0", "1.1"]}}},
      "then": {
        "properties": {
          "figures": {
            "items": {
              "properties": {"outputs": {"minItems": 3}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {
        "properties": {
          "figures": {
            "items": {
              "required": ["template_id", "result_id", "input_result", "reference_template", "renderer_script", "outputs", "text_boxes", "question_id", "claim_ids", "figure_stage", "scientific_question", "expected_takeaway", "cannot_prove", "source_result_ids", "source_result_sha256s", "objective_semantics_sha256"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {
        "properties": {
          "figures": {
            "items": {
              "required": ["template_id", "result_id", "input_result", "renderer_script", "outputs", "question_id", "figure_stage", "source", "question", "takeaway", "source_result_ids", "source_result_sha256s", "objective_semantics_sha256"]
            }
          }
        }
      }
    },
    {
      "$comment": "1.3 允许纯呈现图绑定冻结输入文件，而不伪装成实验结果。",
      "if": {"properties": {"schema_version": {"const": "1.3"}}},
      "then": {
        "properties": {
          "figures": {
            "items": {
              "oneOf": [
                {
                  "required": [
                    "template_id", "result_id", "input_result", "renderer_script",
                    "outputs", "question_id", "figure_stage", "source", "question",
                    "takeaway", "source_result_ids", "source_result_sha256s",
                    "objective_semantics_sha256"
                  ],
                  "properties": {
                    "provenance_type": {"enum": ["result"]}
                  }
                },
                {
                  "required": [
                    "template_id", "provenance_type", "source_files", "renderer_script",
                    "outputs", "question_id", "figure_stage", "source", "question",
                    "takeaway", "limitations", "role", "placement", "presentation_role",
                    "promotion_receipt"
                  ],
                  "properties": {
                    "provenance_type": {"const": "frozen_inputs"}
                  },
                  "not": {
                    "anyOf": [
                      {"required": ["result_id"]},
                      {"required": ["input_result"]},
                      {"required": ["source_result_ids"]},
                      {"required": ["source_result_sha256s"]},
                      {"required": ["objective_semantics_sha256"]}
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
