{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/simple_paper_compile_receipt.schema.json",
  "title": "Capability-First v3 Paper Compile Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "template_manifest_path", "template_manifest_sha256", "engine", "requested_engine", "fallback_used", "fallback_reason", "compiler", "entrypoint_path", "entrypoint_sha256", "paper_source_sha256", "final_pdf_path", "final_pdf_sha256", "executions", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "template_manifest_path": {"const": "paper/template_manifest.json"},
    "template_manifest_sha256": {"$ref": "#/$defs/sha"},
    "engine": {"enum": ["latex", "typst"]},
    "requested_engine": {"enum": ["auto", "latex", "typst"]},
    "fallback_used": {"type": "boolean"},
    "fallback_reason": {"type": ["string", "null"]},
    "compiler": {"enum": ["latexmk", "xelatex", "pdflatex", "tectonic", "typst"]},
    "entrypoint_path": {"pattern": "^(paper/main\\.(tex|typ)|paper/imported-author/main\\.tex)$"},
    "entrypoint_sha256": {"$ref": "#/$defs/sha"},
    "external_author_compile": {"type": "boolean"},
    "external_draft_sha256": {"$ref": "#/$defs/sha"},
    "import_audit_sha256": {"$ref": "#/$defs/sha"},
    "handoff_revision": {"type": "integer", "minimum": 0},
    "paper_source_sha256": {"$ref": "#/$defs/sha"},
    "formal_result_digest": {"type": ["string", "null"]},
    "paper_policy_fingerprint": {"$ref": "#/$defs/sha"},
    "visual_policy_fingerprint": {"$ref": "#/$defs/sha"},
    "final_pdf_path": {"const": "paper/final.pdf"},
    "final_pdf_sha256": {"$ref": "#/$defs/sha"},
    "strict_mode": {"type": "boolean"},
    "reference_docx_path": {"type": "string", "minLength": 1},
    "reference_docx_sha256": {"$ref": "#/$defs/sha"},
    "page_budget_path": {"const": "qa/paper-page-budget.json"},
    "page_budget_sha256": {"$ref": "#/$defs/sha"},
    "page_count": {"type": "integer", "minimum": 1},
    "page_budget_status": {"enum": ["under_18_review_required", "compression_review_required", "normal_range", "over_30_review_required"]},
    "paper_render_revision": {"type": "integer", "minimum": 1},
    "render_revision": {"type": "integer", "minimum": 1},
    "argument_revision": {"type": "integer", "minimum": 1},
    "revision_impact": {"enum": ["render", "argument", "science"]},
    "final_docx_path": {"const": "paper/final.docx"},
    "final_docx_sha256": {"$ref": "#/$defs/sha"},
    "docx_qa_path": {"const": "qa/docx-structure.json"},
    "docx_qa_sha256": {"$ref": "#/$defs/sha"},
    "docx_skipped_reason": {"type": "string", "minLength": 1},
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/execution"}
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"engine": {"const": "latex"}}},
      "then": {
        "properties": {
          "entrypoint_path": {
            "enum": ["paper/main.tex", "paper/imported-author/main.tex"]
          }
        }
      }
    },
    {
      "if": {"properties": {"engine": {"const": "typst"}}},
      "then": {"properties": {"compiler": {"const": "typst"}, "entrypoint_path": {"const": "paper/main.typ"}}}
    },
    {
      "if": {"properties": {"fallback_used": {"const": true}}},
      "then": {"properties": {"fallback_reason": {"type": "string", "minLength": 16}}}
    },
    {
      "if": {"properties": {"fallback_used": {"const": false}}},
      "then": {"properties": {"fallback_reason": {"type": "null"}}}
    },
    {
      "oneOf": [
        {"required": ["final_docx_path", "final_docx_sha256", "docx_qa_path", "docx_qa_sha256"], "not": {"required": ["docx_skipped_reason"]}},
        {"required": ["docx_skipped_reason"], "not": {"required": ["final_docx_path"]}}
      ]
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "stdout_sha256", "stderr_sha256"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exit_code": {"const": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha"},
        "stderr_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
