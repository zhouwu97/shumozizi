{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/simple_run_state.schema.json",
  "title": "Competition-First v3 Simple Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workflow", "phase", "revision", "competition", "problem_id", "required_questions", "current_question", "completed_questions", "selected_route", "fallback_route", "artifacts", "time_budget", "token_budget", "updated_at"],
  "properties": {
    "schema_version": {"enum": ["3.0", "3.1", "3.2"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "workflow": {"enum": ["capability-first-v3", "competition-first-v3.1", "competition-first-v3.2"]},
    "phase": {"enum": ["analysis", "capability_route", "experiment", "scientific_review", "visualization", "paper", "paper_review", "verify", "final_review", "complete", "blocked"]},
    "legacy_phase": {"type": "string"},
    "execution_mode": {"enum": ["production", "exploration"]},
    "revision": {"type": "integer", "minimum": 0},
    "paper_render_revision": {"type": "integer", "minimum": 0},
    "paper_reviewed_revision": {"type": "integer", "minimum": 0},
    "layout_audited_revision": {"type": "integer", "minimum": 0},
    "argument_revision": {"type": "integer", "minimum": 0},
    "render_revision": {"type": "integer", "minimum": 0},
    "reviewed_argument_revision": {"type": "integer", "minimum": 0},
    "layout_audited_render_revision": {"type": "integer", "minimum": 0},
    "competition": {"type": "string"},
    "problem_id": {"type": "string"},
    "required_questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "current_question": {"type": ["string", "null"]},
    "completed_questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selected_route": {"type": ["string", "null"]},
    "fallback_route": {"type": ["string", "null"]},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}},
    "time_budget": {"type": "object", "additionalProperties": false, "required": ["total_hours", "remaining_hours"], "properties": {"total_hours": {"type": ["number", "null"], "minimum": 0}, "remaining_hours": {"type": ["number", "null"], "minimum": 0}}},
    "token_budget": {"type": "object", "additionalProperties": false, "required": ["soft_cap", "used_estimate"], "properties": {"soft_cap": {"type": ["integer", "null"], "minimum": 0}, "used_estimate": {"type": ["integer", "null"], "minimum": 0}}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "3.1"}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "workflow": {"const": "competition-first-v3.1"},
          "phase": {"enum": ["analysis", "experiment", "paper", "paper_review", "verify", "complete", "blocked"]}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "3.2"}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "workflow": {"const": "competition-first-v3.2"},
          "phase": {"enum": ["analysis", "experiment", "paper", "paper_review", "verify", "complete", "blocked"]}
        }
      }
    }
  ]
}
