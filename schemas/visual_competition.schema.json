{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/visual_competition.schema.json",
  "title": "Visual sandbox competition review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "run_id", "idea_id", "reviewer_context_id", "candidates", "selected_candidate", "fastest_mechanism", "full_width_value", "table_redundancy", "rationale", "recorded_at"],
  "properties": {
    "schema_name": {"const": "visual_competition"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "idea_id": {"type": "string", "minLength": 1},
    "reviewer_context_id": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "selected_candidate": {"type": "string", "minLength": 1},
    "fastest_mechanism": {"type": "string", "minLength": 1},
    "full_width_value": {"type": "string", "minLength": 1},
    "table_redundancy": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
