{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/visual_opportunity_pool.schema.json",
  "title": "Visual opportunity pool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "policy_fingerprint",
    "generated_at",
    "status",
    "opportunities"
  ],
  "properties": {
    "schema_name": {"const": "visual_opportunity_pool"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "policy_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["draft", "current", "stale"]},
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "opportunity_id",
          "question_id",
          "visual_question",
          "atomic_claim",
          "source_result_ids",
          "candidate_archetypes",
          "status"
        ],
        "properties": {
          "opportunity_id": {"type": "string", "minLength": 1},
          "question_id": {"type": ["string", "null"]},
          "visual_question": {"type": "string", "minLength": 1},
          "atomic_claim": {"type": "string", "minLength": 1},
          "source_result_ids": {"type": "array", "items": {"type": "string"}},
          "source_figure_ids": {"type": "array", "items": {"type": "string"}},
          "candidate_archetypes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "selected_archetype": {"type": ["string", "null"]},
          "paper_location": {"type": ["string", "null"]},
          "status": {"enum": ["candidate", "promote", "revise", "split", "drop"]},
          "critic_verdict": {"enum": ["PROMOTE", "REVISE", "SPLIT", "DROP", null]},
          "critic_path": {"type": ["string", "null"]}
        }
      }
    }
  }
}
