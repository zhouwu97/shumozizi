{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouwu97/shumozizi/schemas/writer_handoff_manifest.schema.json",
  "title": "Writer handoff manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "run_id", "handoff_revision",
    "paper_policy_fingerprint", "formal_result_digest",
    "material_pool_digest", "storyboard_digest", "claim_boundary_digest",
    "figure_catalog_digest", "citation_packet_digest", "writer_files", "generated_at"
  ],
  "properties": {
    "schema_name": {"const": "writer_handoff_manifest"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "handoff_revision": {"type": "integer", "minimum": 0},
    "paper_policy_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "formal_result_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "material_pool_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "storyboard_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "claim_boundary_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "figure_catalog_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "citation_packet_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "writer_files": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
